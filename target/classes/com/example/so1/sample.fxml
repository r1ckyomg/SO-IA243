<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="10.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.so1.Controller">

    <padding>
        <Insets bottom="20.0"
                left="20.0"
                right="20.0"
                top="20.0"/>
    </padding>

    <Label text="Лабораторная работа — Таймеры"/>

    <HBox spacing="10.0" alignment="CENTER">
        <Label text="Задержка (сек):"/>
        <TextField fx:id="delayField" prefWidth="100"/>
        <Button text="Таймер 1"
                onAction="#startTimer1"/>
    </HBox>

    <HBox spacing="10.0" alignment="CENTER">
        <Label text="Длительность (сек):"/>
        <TextField fx:id="durationField" prefWidth="100"/>
        <Button text="Таймер 2"
                onAction="#startTimer2"/>
    </HBox>

    <HBox spacing="10.0" alignment="CENTER">
        <Label text="Период (сек):"/>
        <TextField fx:id="periodField" prefWidth="100"/>
        <Button text="Запустить таймер 3"
                onAction="#startTimer3"/>
        <Button text="Остановить"
                onAction="#stopTimer3"/>
    </HBox>

    <Label text="Журнал:"/>

    <TextArea fx:id="logArea"
              prefHeight="180"
              prefWidth="400"
              editable="false"/>

</VBox>
